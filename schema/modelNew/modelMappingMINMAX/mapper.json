{
  "fields": {
    "serialNumber": {
      "path": "attributes.serialNumber"
    },
    "firmware": {
      "path": "attributes.firmware"
    },
    "hardwareModel": {
      "path": "attributes.hardwareModel"
    },
    "opMode": {
      "path": "system.status.mode"
    },
    "uptime": {
      "path": "system.status.uptime_seconds"
    },
    "errorCode": {
      "path": "diagnostics.faults.code"
    },
    "activeAlarms": {
      "path": "diagnostics.faults.alarms"
    },
    "oilLevel": {
      "path": "diagnostics.health.oil_level",
      "historyPath": "historicalTelemetry.oil_level"
    },
    "vibration": {
      "path": "diagnostics.health.vibration",
      "historyPath": "historicalTelemetry.vibration"
    },
    "vibrationHistory": {
      "path": "historicalTelemetry.vibration",
      "operation": "array"
    },
    "vibrationMin": {
      "path": "historicalTelemetry.vibration",
      "operation": "min"
    },
    "vibrationMax": {
      "path": "historicalTelemetry.vibration",
      "operation": "max"
    },
    "pressStage1": {
      "path": "performance.stages.p1",
      "historyPath": "historicalTelemetry.p1"
    },
    "pressStage2": {
      "path": "performance.stages.p2",
      "historyPath": "historicalTelemetry.p2"
    },
    "tempInlet": {
      "path": "performance.stages.tempIn",
      "historyPath": "historicalTelemetry.tempIn"
    },
    "tempOutlet": {
      "path": "performance.stages.tempOut",
      "historyPath": "historicalTelemetry.tempOut"
    },
    "motorLoad": {
      "path": "performance.electrical.load",
      "historyPath": "historicalTelemetry.load"
    },
    "powerDraw": {
      "path": "performance.electrical.kw",
      "historyPath": "historicalTelemetry.kw"
    },
    "lineVoltage": {
      "path": "performance.electrical.voltage",
      "historyPath": "historicalTelemetry.voltage"
    },
    "powerFactor": {
      "path": "performance.electrical.pf",
      "historyPath": "historicalTelemetry.pf"
    },
    "airflow": {
      "path": "performance.output.flow",
      "historyPath": "historicalTelemetry.flow"
    },
    "totalRuntime": {
      "path": "performance.output.total_runtime",
      "historyPath": "historicalTelemetry.total_runtime"
    },
    "totalEnergy": {
      "path": "performance.output.energy_kwh",
      "historyPath": "historicalTelemetry.energy_kwh"
    },
    "deviceType": {
      "path": "system.identity.serial"
    }
  },
  "dashboard": {
    "sections": [
      {
        "id": "overview",
        "title": "COMPRESSOR OVERVIEW",
        "columns": 4,
        "items": [
          {
            "id": "serial-number",
            "component": "value-card",
            "bind": "serialNumber",
            "title": "Serial Number"
          },
          {
            "id": "hardware-model",
            "component": "value-card",
            "bind": "hardwareModel",
            "title": "Hardware Model"
          },
          {
            "id": "firmware",
            "component": "value-card",
            "bind": "firmware",
            "title": "Firmware"
          },
          {
            "id": "uptime",
            "component": "value-card",
            "bind": "uptime",
            "title": "Uptime"
          },
          {
            "id": "mode",
            "component": "value-card",
            "bind": "opMode",
            "title": "Operating Mode"
          },
          {
            "id": "airflow",
            "component": "value-card",
            "bind": "airflow",
            "title": "Airflow"
          },
          {
            "id": "power",
            "component": "value-card",
            "bind": "powerDraw",
            "title": "Power Draw",
            "unit": "kW"
          },
          {
            "id": "oil-level",
            "component": "oil-gauge",
            "bind": "oilLevel",
            "title": "Oil Level",
            "unit": "%"
          },
          {
            "id": "oil-warning",
            "component": "value-card",
            "bind": "oilLevel",
            "title": "LOW OIL WARNING",
            "visibleWhen": {
              "bind": "opMode",
              "equals": "FAULT"
            }
          }
        ]
      },
      {
        "id": "advanced-diagnostics",
        "title": "ADVANCED SYSTEM DIAGNOSTICS",
        "columns": 2,
        "items": [
          {
            "id": "outlet-temp-gauge",
            "component": "temperature-thermometer",
            "bind": "tempOutlet",
            "title": "Outlet Temperature",
            "min": 40,
            "max": 120
          },
          {
            "id": "vibration-signal",
            "component": "signal-strength",
            "bind": "vibration",
            "title": "Vibration Intensity"
          }
        ]
      },
      {
        "id": "history",
        "title": "TELEMETRY HISTORY",
        "columns": 4,
        "items": [
          {
            "id": "uptime-chart",
            "component": "line-chart",
            "bind": "uptime",
            "title": "Uptime History",
            "colSpan": 2
          },
          {
            "id": "uptime-table",
            "component": "table",
            "bind": "uptime",
            "title": "Uptime Table",
            "colSpan": 2
          },
          {
            "id": "power-chart",
            "component": "line-chart",
            "bind": "powerDraw",
            "title": "Power Draw History",
            "unit": "kW",
            "colSpan": 2
          },
          {
            "id": "power-table",
            "component": "table",
            "bind": "powerDraw",
            "title": "Power Draw Table",
            "unit": "kW",
            "colSpan": 2
          },
          {
            "id": "temp-out-chart",
            "component": "line-chart",
            "bind": "tempOutlet",
            "title": "Outlet Temp History",
            "unit": "°C",
            "colSpan": 2
          },
          {
            "id": "pressure-stage2-chart",
            "component": "line-chart",
            "bind": "pressStage2",
            "title": "Pressure Stage 2 History",
            "unit": "bar",
            "colSpan": 2
          }
        ]
      },
      {
        "id": "controls",
        "title": "COMPRESSOR CONTROLS",
        "columns": 4,
        "items": [
          {
            "id": "target-pressure",
            "component": "numeric-input",
            "title": "Target Pressure",
            "bind": "pressStage2",
            "command": "SET_TARGET_PRESSURE",
            "commandField": "value",
            "min": 2,
            "max": 16,
            "step": 1
          }
        ]
      },
      {
        "id": "complex controls",
        "title": "OPERATING PROFILE",
        "columns": 2,
        "items": [
          {
            "id": "operating-profile",
            "component": "command-form",
            "title": "Operating Profile",
            "command": "SET_OPERATING_PROFILE"
          }
        ]
      },
      {
        "id": "mapping-demo",
        "title": "MAPPING OPERATIONS",
        "columns": 3,
        "items": [
          {
            "id": "vibration-min",
            "component": "value-card",
            "bind": "vibrationMin",
            "title": "Minimum Vibration"
          },
          {
            "id": "vibration-max",
            "component": "value-card",
            "bind": "vibrationMax",
            "title": "Maximum Vibration"
          },
          {
            "id": "vibration-history",
            "component": "table",
            "bind": "vibrationHistory",
            "title": "Vibration Samples",
            "colSpan": 3
          }
        ]
      }
    ]
  }
}