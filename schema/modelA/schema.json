{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeviceDashboard Telemetry Schema",
  "description": "Šema za validaciju dolaznih poruka sa simulatora Model A",
  "type": "object",
    "commands": {


    "SET_STATE": {
      "payload": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "IDLE"
            ]
          }
        },
          "additionalProperties": false
      }
    }
  },
  
  "properties": {
    "schemaId": { 
      "type": "string",
      "const": "modelA" 
    },
    "telemetry": {
      "type": "object",
      
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": -50,
          "maximum": 100
        },
        "humidity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "pressure": {
          "type": "number",
          "minimum": 300,
          "maximum": 1200
        },
        "led": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
     
    "historicalTelemetry": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "temperature": {
            "type": "number",
            "minimum": -50,
            "maximum": 100
          },
          "humidity": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "pressure": {
            "type": "number",
            "minimum": 300,
            "maximum": 1200
          },
          "led": {
            "type": "boolean"
          }
        },
        "required": [
          "timestamp",
          "temperature",
          "humidity",
          "pressure",
          "led"

        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}