{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeviceDashboard Telemetry Schema",
  "description": "Šema za validaciju dolaznih poruka sa simulatora Model A",
  "type": "object",
  "commands": {
    "SET_STATE": {
      "payload": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": {
            "type": "string",
            "enum": ["ACTIVE", "IDLE"]
          }
        },
        "additionalProperties": false
      }
    },
     "SET_LED": {
      "x-state-path": "telemetry.led",
      "x-payload-field": "value",
      "payload": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "value": {
            "type": "boolean"
          }
        },
          "additionalProperties": false
      }
    }
  },
  "properties": {
    "schemaId": { 
      "type": "string",
      "const": "modelA"
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": -50,
          "maximum": 100
        },
        "humidity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "pressure": {
          "type": "number",
          "minimum": 300,
          "maximum": 1200
        },
        "led": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "historicalTelemetry": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "array",
          "maxItems": 24,

          "items": {
            "type": "array",

            "prefixItems": [
              {
                "type": "number",
                "minimum": -50,
                "maximum": 100
              },
              {
                "type": "string"
              }
            ],

            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
      
        },
        "humidity": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": 0, "maximum": 100 },
            { "type": "string" }
          ],
          "items": false,
            "minItems": 2,
            "maxItems": 2
        }
        },
        "pressure": {
          "type": "array",
          "maxItems": 24,
          "items": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": 300, "maximum": 1200 },
            { "type": "string" }
          ],
          "items": false,
           "minItems": 2,
            "maxItems": 2
        }
        }
      },
      "required": ["temperature", "humidity", "pressure"],
      "additionalProperties": false
      
    }
  },
  "additionalProperties": false
}