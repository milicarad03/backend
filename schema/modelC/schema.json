{
  "type": "object",
  "required": ["schemaId"],
  "properties": {
    "schemaId": { 
      "type": "string",
      "const": "modelC" 
    },
    "metrics": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "object",
          "properties": {
            "temperature": { "type": "number" },
            "humidity": { "type": "number" },
            "pressure": { "type": "number" }
          }
        }
      }
    },
    "device": {
      "type": "object",
      "properties": {
        "status": {
          "type": "object",
          "properties": {
            "led": { "type": "boolean" },
            "mode": { "type": "string" }
          }
        },
        "battery": {
          "type": "object",
          "properties": {
            "level": { "type": "number" },
            "charging": { "type": "boolean" }
          }
        }
      }
    }
  }
}