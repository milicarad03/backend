// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
 
}

datasource db {
  provider = "postgresql"
}

enum Role{
  USER
  ADMIN
}

model User { 
  id    Int     @id @default(autoincrement()) 
  email String  @unique
  name  String?
  password String @default("promeni_me")  //svi ostali koji su vec u bazi dok nije bilo polja pswd dobice ovo kao default vrednost
  posts Post[]
  devices Device[]
  role  Role   @default(USER)
} 

model Post { 
  id        Int     @id @default(autoincrement()) 
  title     String
  content   String?
  published Boolean @default(false) 
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  Int
} 

model Device {
  id              String   @id @default(uuid())
  serialNumber    String   @unique // npr. "SN-100234" (ono što piše na nalepnici)
  name            String?
  type            String?   // npr. "Senzor u hodniku"
  apiKey          String   @unique @default(cuid()) // Tajni ključ za pristup API-ju
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  lastseen        DateTime @default(now())
}