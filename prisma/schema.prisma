// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
 
}

datasource db {
  provider = "postgresql"
}

enum Role{
  USER
  ADMIN
}
enum UserStatus{
  PENDING
  APPROVED
  REJECTED
}
enum DeviceStatus {
  UNINITIALIZED
  ONLINE
  OFFLINE
}

enum TelemetryState {
  ACTIVE
  IDLE
}

enum CommandAuditResult {
  PENDING
  SUCCESS
  FAILURE
  NOOP
}

model User { 
  id    Int     @id @default(autoincrement()) 
  email String  @unique
  name  String?
  password String @default("promeni_me")  
  posts Post[]
  devices Device[]
  role  Role   @default(USER)
  status   UserStatus @default(PENDING)
  commandAudits CommandAudit[]
} 

model Post { 
  id        Int     @id @default(autoincrement()) 
  title     String
  content   String?
  published Boolean @default(false) 
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  Int
} 

model Device {
  id              String   @id @default(uuid())
  serialNumber    String   @unique 
  name            String?
  type            String?   
  apiKey          String   @unique @default(cuid()) 
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  lastseen        DateTime @default(now())
  status        DeviceStatus @default(UNINITIALIZED)
  telemetryState  TelemetryState @default(IDLE)
  telemetryStateUpdatedAt DateTime?
  telemetry DeviceTelemetry[]
  attributes      Json?

  modelVersion   ModelVersion? @relation(fields: [modelVersionId], references: [id])
  modelVersionId String?
  
  isVerified     Boolean  @default(false) 

  certSerialNumber String? @unique
  verifiedAt       DateTime?

}
model DeviceTelemetry {
  id             String   @id @default(uuid())

  deviceId       String
  timestamp      DateTime
  data           Json
  createdAt      DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [serialNumber], onDelete: Cascade)
  modelVersionId String?
  modelVersion ModelVersion? @relation(fields: [modelVersionId], references: [id])

}

model CommandAudit {
  id            String             @id @default(uuid())
  userId        Int?
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  deviceId      String
  command       String
  payload       Json?
  correlationId String             @unique
  result        CommandAuditResult @default(PENDING)
  error         String?
  createdAt     DateTime           @default(now())
  completedAt   DateTime?

  @@index([deviceId, createdAt])
  @@index([userId, createdAt])
  @@index([result, createdAt])
}

model DeviceModel {
  id        String   @id @default(uuid())
  name      String   @unique 
  description String?

  versions  ModelVersion[]
}

model ModelVersion {
  id        String   @id @default(uuid())

  version   String   

  schema    Json
  mapping   Json

  model     DeviceModel @relation(fields: [modelId], references: [name], onDelete: Cascade)
  modelId   String

  devices   Device[]

  @@unique([modelId, version]) 
  telemetry DeviceTelemetry[]
}
